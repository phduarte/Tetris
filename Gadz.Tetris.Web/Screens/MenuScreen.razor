@inherits ConsoleScreen

<div class="screen menu">
    <div class="record">
        <span class="label">@Texts[nameof(Jogo.Recorde)]</span>
        <Digits Text="@_record" Class="small" />
    </div>

    <div class="title-block">
        <TitleArt />
        <p class="subtitle">@Texts[nameof(Jogo.Subtitle)]</p>
    </div>

    <div class="sound-state">
        <span class="label">@Texts[nameof(Jogo.Sound)]</span>
        <span>@(Frame.Sound.Mute ? Texts[nameof(Jogo.SomDesligado)] : $"♪ {Texts[nameof(Jogo.SomLigado)]}")</span>
    </div>

    <div class="ground-block">
        <p class="press blink">@Texts[nameof(Jogo.EnterToPlay)]</p>
        <BlockGrid Columns="_ground[0].Length" Rows="_ground.Length" ColorAt="GroundColor" Class="ground" />
    </div>
</div>

<ConsoleButtons Buttons="Buttons" />
