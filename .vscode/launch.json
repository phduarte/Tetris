{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Web (Blazor WebAssembly)",
      "type": "blazorwasm",
      "request": "launch",
      "cwd": "${workspaceFolder}/Gadz.Tetris.Web",
      "url": "http://localhost:5156",
      "browser": "edge"
    },
    {
      "name": "Desktop (WinForms)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build-desktop",
      "program": "${workspaceFolder}/Gadz.Tetris.Desktop/bin/Debug/net10.0-windows/Gadz.Tetris.Desktop.exe",
      "cwd": "${workspaceFolder}/Gadz.Tetris.Desktop",
      "console": "internalConsole",
      "stopAtEntry": false
    }
  ]
}
